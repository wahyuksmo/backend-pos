// Password Policy Schema
// Table: pos_passwordpolicy

model PasswordPolicy {
  passwordPolicyId String   @id @default(uuid()) @map("passwordpolicy_id") @db.Uuid
  code             String   @unique @map("code") @db.VarChar
  value            String   @map("value") @db.VarChar
  message          String   @map("message") @db.VarChar
  objectCode       String   @default("PASSWORD_POLICY") @map("object_code") @db.VarChar
  createdBy        String?  @map("created_by") @db.VarChar
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by") @db.VarChar

  @@map("pos_passwordpolicy")
}
