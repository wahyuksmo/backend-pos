// Password History Schema
// Table: pos_passwordhistory

model PasswordHistory {
  passwordhistoryId String   @id @default(uuid()) @map("passwordhistory_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  oldPassword       String   @map("old_password") @db.VarChar
  newPassword       String   @map("new_password") @db.VarChar
  objectCode        String   @default("PASSWORD_HISTORY") @map("object_code") @db.VarChar
  createdBy         String?  @map("created_by") @db.VarChar
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy         String?  @map("updated_by") @db.VarChar

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("pos_passwordhistory")
}
