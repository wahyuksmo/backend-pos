// POS Sales & Cashier Transaction Schema
// Tables: pos_register_shifts, pos_cash_movements, pos_orders,
//         pos_order_items, pos_order_item_modifiers, pos_order_payments

model PosRegisterShift {
  shiftId          String    @id @default(uuid()) @map("shift_id") @db.Uuid
  shiftCode        String    @unique @map("shift_code") @db.VarChar
  outletId         String    @map("outlet_id") @db.Uuid
  registerId       String    @map("register_id") @db.Uuid
  cashierUserId    String    @map("cashier_user_id") @db.Uuid
  openedAt         DateTime  @default(now()) @map("opened_at")
  closedAt         DateTime? @map("closed_at")

  openingCash      Decimal   @default(0) @map("opening_cash") @db.Decimal(15, 2)
  expectedCash     Decimal   @default(0) @map("expected_cash") @db.Decimal(15, 2)
  actualCash       Decimal?  @map("actual_cash") @db.Decimal(15, 2)
  cashDifference   Decimal?  @map("cash_difference") @db.Decimal(15, 2)

  totalSalesAmount Decimal   @default(0) @map("total_sales_amount") @db.Decimal(15, 2)
  totalOrdersCount Int       @default(0) @map("total_orders_count")
  status           String    @default("OPEN") @map("status") @db.VarChar(20) // OPEN, CLOSED, AUDITED
  closingNotes     String?   @map("closing_notes") @db.Text

  isActive         String    @default("Y") @map("is_active") @db.VarChar(1)
  objectCode       String    @default("REGISTER_SHIFT") @map("object_code") @db.VarChar
  createdBy        String?   @map("created_by") @db.VarChar
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by") @db.VarChar

  outlet           PosOutlet         @relation(fields: [outletId], references: [outletId], onDelete: Cascade)
  register         PosRegister       @relation(fields: [registerId], references: [registerId], onDelete: Cascade)
  cashierUser      User              @relation(fields: [cashierUserId], references: [userId], onDelete: Restrict)
  cashMovements    PosCashMovement[]
  orders           PosOrder[]

  @@index([outletId])
  @@index([registerId])
  @@index([cashierUserId])
  @@index([status])
  @@map("pos_register_shifts")
}

model PosCashMovement {
  movementId   String   @id @default(uuid()) @map("movement_id") @db.Uuid
  shiftId      String   @map("shift_id") @db.Uuid
  movementType String   @map("movement_type") @db.VarChar(20) // CASH_IN, CASH_OUT
  amount       Decimal  @default(0) @map("amount") @db.Decimal(15, 2)
  reason       String   @map("reason") @db.VarChar(255)
  recipient    String?  @map("recipient") @db.VarChar(100)
  authorizedBy String?  @map("authorized_by") @db.VarChar(100)

  isActive     String   @default("Y") @map("is_active") @db.VarChar(1)
  objectCode   String   @default("CASH_MOVEMENT") @map("object_code") @db.VarChar
  createdBy    String?  @map("created_by") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by") @db.VarChar

  shift        PosRegisterShift @relation(fields: [shiftId], references: [shiftId], onDelete: Cascade)

  @@index([shiftId])
  @@map("pos_cash_movements")
}

model PosOrder {
  orderId             String    @id @default(uuid()) @map("order_id") @db.Uuid
  orderNumber         String    @unique @map("order_number") @db.VarChar(50)
  invoiceNumber       String?   @unique @map("invoice_number") @db.VarChar(50)
  shiftId             String?   @map("shift_id") @db.Uuid
  outletId            String    @map("outlet_id") @db.Uuid
  registerId          String?   @map("register_id") @db.Uuid
  channelId           String?   @map("channel_id") @db.Uuid
  tableId             String?   @map("table_id") @db.Uuid
  customerId          String?   @map("customer_id") @db.Uuid

  orderType           String    @default("DINE_IN") @map("order_type") @db.VarChar(30) // DINE_IN, TAKE_AWAY, DELIVERY, DRIVE_THRU
  orderStatus         String    @default("OPEN") @map("order_status") @db.VarChar(30) // OPEN, HELD, IN_PROGRESS, COMPLETED, CANCELLED, VOIDED
  paymentStatus       String    @default("UNPAID") @map("payment_status") @db.VarChar(30) // UNPAID, PARTIAL, PAID, REFUNDED

  guestName           String?   @map("guest_name") @db.VarChar(100)
  paxCount            Int       @default(1) @map("pax_count")

  subtotal            Decimal   @default(0) @map("subtotal") @db.Decimal(15, 2)
  discountAmount      Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  discountId          String?   @map("discount_id") @db.Uuid
  surchargeAmount     Decimal   @default(0) @map("surcharge_amount") @db.Decimal(15, 2)
  taxAmount           Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  tipAmount           Decimal   @default(0) @map("tip_amount") @db.Decimal(15, 2)
  roundingAmount      Decimal   @default(0) @map("rounding_amount") @db.Decimal(15, 2)
  totalAmount         Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount          Decimal   @default(0) @map("paid_amount") @db.Decimal(15, 2)
  changeAmount        Decimal   @default(0) @map("change_amount") @db.Decimal(15, 2)

  loyaltyPointsEarned Decimal   @default(0) @map("loyalty_points_earned") @db.Decimal(12, 2)
  loyaltyPointsUsed   Decimal   @default(0) @map("loyalty_points_used") @db.Decimal(12, 2)

  orderedAt           DateTime  @default(now()) @map("ordered_at")
  paidAt              DateTime? @map("paid_at")
  closedAt            DateTime? @map("closed_at")
  voidedAt            DateTime? @map("voided_at")
  voidReason          String?   @map("void_reason") @db.Text
  voidBy              String?   @map("void_by") @db.VarChar
  notes               String?   @map("notes") @db.Text

  isActive            String    @default("Y") @map("is_active") @db.VarChar(1)
  objectCode          String    @default("ORDER") @map("object_code") @db.VarChar
  createdBy           String?   @map("created_by") @db.VarChar
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy           String?   @map("updated_by") @db.VarChar

  shift               PosRegisterShift? @relation(fields: [shiftId], references: [shiftId], onDelete: SetNull)
  outlet              PosOutlet         @relation(fields: [outletId], references: [outletId], onDelete: Restrict)
  register            PosRegister?      @relation(fields: [registerId], references: [registerId], onDelete: SetNull)
  channel             PosSalesChannel?  @relation(fields: [channelId], references: [channelId], onDelete: SetNull)
  table               PosDiningTable?   @relation(fields: [tableId], references: [tableId], onDelete: SetNull)
  customer            PosCustomer?      @relation(fields: [customerId], references: [customerId], onDelete: SetNull)
  discount            PosDiscount?      @relation(fields: [discountId], references: [discountId], onDelete: SetNull)

  items               PosOrderItem[]
  payments            PosOrderPayment[]

  @@index([orderNumber])
  @@index([invoiceNumber])
  @@index([outletId])
  @@index([shiftId])
  @@index([tableId])
  @@index([customerId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("pos_orders")
}

model PosOrderItem {
  orderItemId        String    @id @default(uuid()) @map("order_item_id") @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  variantId          String?   @map("variant_id") @db.Uuid
  kitchenStationId   String?   @map("kitchen_station_id") @db.Uuid

  itemCode           String    @map("item_code") @db.VarChar(50)
  itemName           String    @map("item_name") @db.VarChar(200)
  variantName        String?   @map("variant_name") @db.VarChar(100)

  quantity           Decimal   @default(1) @map("quantity") @db.Decimal(12, 2)
  unitPrice          Decimal   @default(0) @map("unit_price") @db.Decimal(15, 2)
  costPrice          Decimal   @default(0) @map("cost_price") @db.Decimal(15, 2)
  discountPercent    Decimal   @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount     Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxPercent         Decimal   @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount          Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  modifiersAmount    Decimal   @default(0) @map("modifiers_amount") @db.Decimal(15, 2)
  subtotal           Decimal   @default(0) @map("subtotal") @db.Decimal(15, 2)
  totalAmount        Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)

  itemStatus         String    @default("PENDING") @map("item_status") @db.VarChar(30) // PENDING, SENT_TO_KITCHEN, PREPARING, SERVED, CANCELLED, VOIDED
  isPrintedToKitchen String    @default("N") @map("is_printed_to_kitchen") @db.VarChar(1)
  kitchenSentAt      DateTime? @map("kitchen_sent_at")
  notes              String?   @map("notes") @db.VarChar(255)
  voidReason         String?   @map("void_reason") @db.Text
  voidBy             String?   @map("void_by") @db.VarChar
  voidAt             DateTime? @map("void_at")

  isActive           String    @default("Y") @map("is_active") @db.VarChar(1)
  objectCode         String    @default("ORDER_ITEM") @map("object_code") @db.VarChar
  createdBy          String?   @map("created_by") @db.VarChar
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy          String?   @map("updated_by") @db.VarChar

  order              PosOrder                @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product            PosProduct              @relation(fields: [productId], references: [productId], onDelete: Restrict)
  variant            PosProductVariant?      @relation(fields: [variantId], references: [variantId], onDelete: SetNull)
  kitchenStation     PosKitchenStation?      @relation(fields: [kitchenStationId], references: [stationId], onDelete: SetNull)
  modifiers          PosOrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@index([itemStatus])
  @@map("pos_order_items")
}

model PosOrderItemModifier {
  itemModifierId    String   @id @default(uuid()) @map("item_modifier_id") @db.Uuid
  orderItemId       String   @map("order_item_id") @db.Uuid
  modifierGroupId   String?  @map("modifier_group_id") @db.Uuid
  modifierItemId    String?  @map("modifier_item_id") @db.Uuid
  modifierGroupName String   @map("modifier_group_name") @db.VarChar(100)
  modifierItemName  String   @map("modifier_item_name") @db.VarChar(100)
  extraPrice        Decimal  @default(0) @map("extra_price") @db.Decimal(15, 2)
  quantity          Int      @default(1) @map("quantity")
  subtotal          Decimal  @default(0) @map("subtotal") @db.Decimal(15, 2)

  isActive          String   @default("Y") @map("is_active") @db.VarChar(1)
  objectCode        String   @default("ORDER_ITEM_MODIFIER") @map("object_code") @db.VarChar
  createdBy         String?  @map("created_by") @db.VarChar
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy         String?  @map("updated_by") @db.VarChar

  orderItem         PosOrderItem @relation(fields: [orderItemId], references: [orderItemId], onDelete: Cascade)

  @@index([orderItemId])
  @@map("pos_order_item_modifiers")
}

model PosOrderPayment {
  paymentId         String    @id @default(uuid()) @map("payment_id") @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  paymentMethodId   String    @map("payment_method_id") @db.Uuid
  paymentMethodCode String    @map("payment_method_code") @db.VarChar(50)
  paymentMethodName String    @map("payment_method_name") @db.VarChar(100)
  paymentType       String    @default("CASH") @map("payment_type") @db.VarChar(30) // CASH, EDC_DEBIT, EDC_CREDIT, QRIS, EWALLET, BANK_TRANSFER

  amount            Decimal   @default(0) @map("amount") @db.Decimal(15, 2)
  tenderedAmount    Decimal   @default(0) @map("tendered_amount") @db.Decimal(15, 2)
  changeAmount      Decimal   @default(0) @map("change_amount") @db.Decimal(15, 2)
  merchantFee       Decimal   @default(0) @map("merchant_fee") @db.Decimal(15, 2)

  referenceNumber   String?   @map("reference_number") @db.VarChar(100)
  cardLastFour      String?   @map("card_last_four") @db.VarChar(4)
  cardHolderName    String?   @map("card_holder_name") @db.VarChar(100)

  paymentStatus     String    @default("SUCCESS") @map("payment_status") @db.VarChar(30) // SUCCESS, PENDING, FAILED, REFUNDED
  paidAt            DateTime  @default(now()) @map("paid_at")
  refundedAt        DateTime? @map("refunded_at")
  refundReason      String?   @map("refund_reason") @db.Text

  isActive          String    @default("Y") @map("is_active") @db.VarChar(1)
  objectCode        String    @default("ORDER_PAYMENT") @map("object_code") @db.VarChar
  createdBy         String?   @map("created_by") @db.VarChar
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by") @db.VarChar

  order             PosOrder         @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  paymentMethod     PosPaymentMethod @relation(fields: [paymentMethodId], references: [paymentMethodId], onDelete: Restrict)

  @@index([orderId])
  @@index([paymentMethodId])
  @@index([paymentStatus])
  @@map("pos_order_payments")
}
