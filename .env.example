# Server Configuration
NODE_ENV=development
PORT=7780
API_PREFIX=api/v1

# Database Connection (PostgreSQL) - Prefix pos_
DATABASE_URL="postgresql://postgres:root@localhost:5432/pos?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="POS_SUPER_SECRET_KEY_FOR_ACCESS_TOKEN_2026"
JWT_REFRESH_SECRET="POS_SUPER_SECRET_KEY_FOR_REFRESH_TOKEN_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_TITLE="POS Enterprise API"
SWAGGER_DESCRIPTION="Enterprise Point of Sale (POS) Clean Architecture API"
SWAGGER_VERSION="1.0"
SWAGGER_PATH="docs"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
